# Supabase — use the SAME project as the extension so users are one pool
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — Price IDs (copy from https://dashboard.stripe.com/test/prices)
# These identify each tier's monthly subscription. Swap test IDs for live IDs
# when flipping to production. All three are public — they appear in the page HTML.
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_BUSINESS=

# Stripe — Publishable key (optional today; needed if we add inline card UI later)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Chrome Web Store deep-link target (blank pre-launch)
NEXT_PUBLIC_EXTENSION_ID=

# NOTE: STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / SUPABASE_SERVICE_ROLE_KEY
# are NOT set here. They live only on the Edge Functions side via
# `supabase secrets set ...`. See docs/EDGE-FUNCTIONS.md.
